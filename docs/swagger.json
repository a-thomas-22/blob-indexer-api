                ],
                "tags": [
                    "blobs"
                ],
                "summary": "Get blob by transaction hash",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Network name or chain ID (default: first enabled network)",
                        "name": "network",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Transaction hash",
                        "name": "txHash",
                        "in": "path",
                        "required": true
