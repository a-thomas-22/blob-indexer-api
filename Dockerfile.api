FROM golang:1.27-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG VERSION=dev
ARG SWAG_VERSION=v1.16.6
RUN go run github.com/swaggo/swag/cmd/swag@${SWAG_VERSION} init -g cmd/api/main.go -o docs
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -ldflags "-X main.version=${VERSION}" -o blob-indexer-api ./cmd/api
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o blob-indexer-migrate ./cmd/migrate

FROM alpine:3.24

WORKDIR /app

RUN apk upgrade --no-cache \
    && apk add --no-cache ca-certificates tzdata \
    && addgroup -g 1000 -S appgroup \
    && adduser -u 1000 -S appuser -G appgroup

COPY --from=builder /app/blob-indexer-api .
COPY --from=builder /app/blob-indexer-migrate .
COPY --from=builder /app/internal/db/migrations ./internal/db/migrations

RUN chown -R appuser:appgroup /app

USER 1000

EXPOSE 8080 8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:8080/api/v1/healthz || exit 1

CMD ["./blob-indexer-api"]
